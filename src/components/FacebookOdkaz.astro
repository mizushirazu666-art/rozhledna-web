---
/**
 * „Sledujte nás na Facebooku“ – odkaz na facebookovou stránku regionu
 * (region.json → facebook). Stránky zatím nemají sledující a Lukáš nemá
 * osobní profil, ze kterého by zval přátele – čtenáři webu jsou hlavní
 * zdroj sledujících (8. 10. 2026).
 *   varianta – "blok" (pod článkem, výrazný) / "odkaz" (patička)
 */
import region from '../data/region.json';

export interface Props {
  varianta?: 'blok' | 'odkaz';
}
const { varianta = 'blok' } = Astro.props;
const url = (region as { facebook?: string }).facebook;
const ikona = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5H16.6V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.4-3.8 3.9v2.3H8v3h2.6V21h2.9Z"/></svg>';
---
{url && (varianta === 'blok' ? (
  <a class="fb-blok" href={url} rel="noopener" target="_blank">
    <span class="fb-blok__ikona" set:html={ikona} />
    <span class="fb-blok__text">
      <strong>Sledujte Rozhlednu na Facebooku</strong>
      <span>Nejdůležitější zprávy z {region.genitiv} každý den ve vašem kanálu.</span>
    </span>
    <span class="fb-blok__tlacitko">Sledovat</span>
  </a>
) : (
  <a class="fb-odkaz" href={url} rel="noopener" target="_blank"><span set:html={ikona} />Facebook</a>
))}

<style>
  .fb-blok {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border: 1px solid var(--barva-ramecek);
    border-radius: 10px;
    color: var(--barva-text);
    text-decoration: none;
    background: var(--barva-pozadi);
  }
  .fb-blok:hover { border-color: #1877f2; }
  .fb-blok__ikona {
    display: grid;
    place-items: center;
    flex: 0 0 40px;
    height: 40px;
    border-radius: 50%;
    background: #1877f2;
    color: #fff;
  }
  .fb-blok__text { display: flex; flex-direction: column; gap: 2px; font-size: 14px; line-height: 1.4; flex: 1; }
  .fb-blok__text strong { font-size: 15px; }
  .fb-blok__text span { color: var(--barva-text-tlumena); }
  .fb-blok__tlacitko {
    flex: 0 0 auto;
    padding: 8px 16px;
    border-radius: 6px;
    background: #1877f2;
    color: #fff;
    font-weight: 600;
    font-size: 14px;
  }
  .fb-odkaz { display: inline-flex; align-items: center; gap: 4px; color: var(--barva-text-tlumena); font-size: 13px; }
  @media (max-width: 520px) {
    .fb-blok { flex-wrap: wrap; }
    .fb-blok__tlacitko { width: 100%; text-align: center; }
  }
</style>
