---
import region from '../data/region.json';
import Logo from './Logo.astro';
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__disclosure">
      <Logo size={18} fill="#6B6154" />
      <span>Rozhledna – {region.nazev} · Obsah připravujeme s pomocí AI, vždy s redakčním přezkumem před publikací.</span>
    </div>
    <nav class="footer__links" aria-label="Patička">
      <a href="/o-nas/">O nás</a>
      <a href="/inzerce/">Inzerce</a>
      <a href="/poslete-fotku/">Pošlete fotku</a>
      <a href="/kontakt/">Kontakt</a>
      <a href="/ochrana-udaju/">Ochrana údajů</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--barva-ramecek);
    margin-top: 40px;
  }
  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 32px;
    padding-bottom: 40px;
  }
  .footer__disclosure {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--barva-text-tlumena);
    font-size: 13px;
    max-width: 640px;
  }
  .footer__links {
    display: flex;
    gap: 24px;
    font-size: 13px;
  }
  .footer__links a { color: var(--barva-text-tlumena); }

  @media (max-width: 900px) {
    .footer__inner { flex-direction: column; align-items: flex-start; }
    .footer__links { flex-wrap: wrap; gap: 16px; }
  }
</style>
