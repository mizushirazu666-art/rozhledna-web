---
import region from '../data/region.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = `Rozhledna – nezávislé hyperlokální zpravodajství pro ${region.nazev}.` } = Astro.props;
---
<!doctype html>
<!-- Hlavní barva regionu (Chrudimsko zelená, Hlinecko petrolejová) přebíjí výchozí z global.css. -->
<html lang="cs" style={`--barva-zelena: ${region.barva}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={region.nazev === 'Chrudimsko' ? '/favicon.svg' : `/favicon-${region.centrum.slug}.svg`} />
    <meta name="description" content={description} />
    <title>{title} · Rozhledna – {region.nazev}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Vercel Web Analytics – anonymní statistiky návštěv bez cookies (zapíná se
         v nastavení projektu na Vercelu, záložka Analytics). -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
