---
import region from '../data/region.json';
import taxonomie from '../data/taxonomie.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import { getClanky } from '../lib/clanky';
import { akceNaDny, nazevDne, jeVikend, kratkeDatum } from '../lib/akce';

// Kalendář akcí na 14 dní (29. 10. 2026) – pozvánky z rubriky Kultura podle
// PlatiDo / DatumZdroje, filtr podle obce v prohlížeči. Web se přestavuje
// 3× denně; prošlé dny skryje i skript níž (statická stránka v noci nestárne).
const clanky = (await getClanky()).filter((c) => c.stav === 'Publikováno');
const akce = akceNaDny(clanky, 14);
const nazevObce = new Map(taxonomie.obce.map((o) => [o.slug, o.nazev]));
const dny = [...new Set(akce.map((a) => a.den))];
const obceSAkci = [...new Set(akce.map((a) => a.clanek.obec))]
  .map((slug) => ({ slug, nazev: nazevObce.get(slug) ?? slug }))
  .sort((a, b) => a.nazev.localeCompare(b.nazev, 'cs'));
---
<BaseLayout title={`Kam vyrazit – akce na ${region.genitiv}`} description={`Kalendář akcí v obcích ${region.genitiv} na nejbližší dva týdny – koncerty, divadlo, jarmarky, akce pro děti.`}>
  <div class="container akce-hlavicka">
    <span class="kicker kicker--zelena">Kam vyrazit</span>
    <h1>Akce v obcích {region.genitiv}</h1>
    <p>Co se chystá v nejbližších dvou týdnech – koncerty, divadlo, jarmarky, akce pro děti i sport v obcích.</p>
    {obceSAkci.length > 1 && (
      <div class="akce-filtr" role="group" aria-label="Akce podle obce">
        <button type="button" class="akce-chip akce-chip--aktivni" data-obec="" aria-pressed="true">Všechny obce</button>
        {obceSAkci.map((o) => <button type="button" class="akce-chip" data-obec={o.slug} aria-pressed="false">{o.nazev}</button>)}
      </div>
    )}
  </div>

  <section class="container akce-seznam">
    {dny.length === 0 && <p class="prazdno">V nejbližších dvou týdnech zatím nemáme žádné pozvánky. Pořádáte akci? Napište nám na redakci.</p>}
    {dny.map((den) => (
      <div class:list={['akce-den', { 'akce-den--vikend': jeVikend(den) }]} data-den={den}>
        <h2>{nazevDne(den)}</h2>
        <ul>
          {akce.filter((a) => a.den === den).map((a) => (
            <li data-obec={a.clanek.obec}>
              <span class="akce-obec">{nazevObce.get(a.clanek.obec) ?? a.clanek.obec}</span>
              <a href={`/clanek/${a.clanek.slug}/`}>{a.clanek.nadpis}</a>
              {a.do !== a.den && <span class="akce-do">až do {kratkeDatum(a.do)}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="akce-filtr-prazdno" hidden>V této obci teď nic nechystáme – zkuste jinou obec.</p>
  </section>

  <div class="container">
    <NewsletterCTA nadpis="Každý pátek přehled akcí na víkend do e-mailu" />
  </div>
</BaseLayout>

<script>
  // Prošlé dny skrýt (stránka se v noci nepřestavuje) a filtr podle obce.
  const dnes = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Prague' }).format(new Date());
  const dny = [...document.querySelectorAll<HTMLElement>('.akce-den')];
  for (const d of dny) if ((d.dataset.den ?? '') < dnes) d.remove();
  const prazdno = document.querySelector<HTMLElement>('.akce-filtr-prazdno');
  const chipy = [...document.querySelectorAll<HTMLButtonElement>('.akce-chip')];
  for (const chip of chipy) chip.addEventListener('click', () => {
    const obec = chip.dataset.obec ?? '';
    for (const c of chipy) {
      const aktivni = c === chip;
      c.classList.toggle('akce-chip--aktivni', aktivni);
      c.setAttribute('aria-pressed', String(aktivni));
    }
    let vidim = 0;
    for (const d of document.querySelectorAll<HTMLElement>('.akce-den')) {
      let vDni = 0;
      for (const li of d.querySelectorAll<HTMLElement>('li')) {
        const ukaz = !obec || li.dataset.obec === obec;
        li.hidden = !ukaz;
        if (ukaz) vDni++;
      }
      d.hidden = vDni === 0;
      vidim += vDni;
    }
    if (prazdno) prazdno.hidden = vidim > 0;
  });
</script>

<style>
  .akce-hlavicka {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--barva-ramecek);
  }
  .akce-hlavicka h1 { font-size: 38px; }
  .akce-hlavicka p { font-size: 17px; color: var(--barva-text-tlumena); max-width: 680px; margin: 0; }
  .akce-filtr { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .akce-chip {
    font: inherit; font-size: 14px; font-weight: 500; cursor: pointer;
    padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--barva-ramecek); background: transparent; color: var(--barva-text);
    transition: background .15s, border-color .15s, color .15s;
  }
  .akce-chip:hover { border-color: var(--barva-zelena); color: var(--barva-zelena); }
  .akce-chip--aktivni, .akce-chip--aktivni:hover { background: var(--barva-zelena); border-color: var(--barva-zelena); color: #fff; }
  .akce-seznam { padding-top: 24px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 28px; max-width: 860px; }
  .akce-den h2 { font-size: 22px; padding-bottom: 8px; border-bottom: 2px solid var(--barva-zelena); margin-bottom: 4px; }
  .akce-den--vikend h2 { border-bottom-color: var(--barva-terakota); }
  .akce-den ul { list-style: none; margin: 0; padding: 0; }
  .akce-den li { display: grid; grid-template-columns: 150px 1fr; align-items: baseline; gap: 4px 20px; padding: 12px 0; border-bottom: 1px solid var(--barva-ramecek); }
  .akce-den li a { font-family: var(--font-nadpisy); font-size: 18px; font-weight: 600; color: var(--barva-text); }
  .akce-den li a:hover { color: var(--barva-terakota); }
  .akce-obec { font-size: 12px; font-weight: 600; letter-spacing: 1.5px; line-height: 1.4; text-transform: uppercase; color: var(--barva-zelena); }
  .akce-do { grid-column: 2; font-size: 14px; color: var(--barva-text-tlumena); }
  .prazdno, .akce-filtr-prazdno { color: var(--barva-text-tlumena); }
  @media (max-width: 900px) {
    .akce-hlavicka { padding-top: 24px; }
    .akce-hlavicka h1 { font-size: 28px; }
    .akce-den li { grid-template-columns: 1fr; gap: 2px; }
    .akce-do { grid-column: 1; }
  }
</style>
