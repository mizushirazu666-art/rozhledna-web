---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import taxonomie from '../../data/taxonomie.json';
import { Image } from 'astro:assets';
import region from '../../data/region.json';
import { getClanky, nazevObceClanku } from '../../lib/clanky';
import { castiTextu } from '../../lib/odkazy';
import { blokTextu } from '../../lib/bloky';
import MapaHodnoty from '../../components/MapaHodnoty.astro';
import FacebookOdkaz from '../../components/FacebookOdkaz.astro';

export async function getStaticPaths() {
  const articlesData = await getClanky();
  return articlesData
    .filter((c) => c.stav === 'Publikováno')
    .map((clanek) => ({ params: { slug: clanek.slug }, props: { clanek, vsechnyClanky: articlesData } }));
}

const { clanek, vsechnyClanky } = Astro.props as {
  clanek: Awaited<ReturnType<typeof getClanky>>[number];
  vsechnyClanky: Awaited<ReturnType<typeof getClanky>>;
};

const rubrikaInfo = taxonomie.rubriky.find((r) => r.slug === clanek.rubrika);
const obecNazev = nazevObceClanku(clanek.obec);
const souvisejici = (clanek.souvisejiciClanky ?? [])
  .map((slug) => vsechnyClanky.find((c) => c.slug === slug))
  .filter((c): c is (typeof vsechnyClanky)[number] => Boolean(c) && c!.stav === 'Publikováno');
// Náhled pro sdílení: fotka článku zmenšená při buildu na stálé adrese
// (src/pages/og/[slug].jpg.ts) – adresy /_astro/… se s každým buildem mění.
const nahled = clanek.obrazek ? `/og/${clanek.slug}.jpg` : undefined;
const adresa = new URL(`/clanek/${clanek.slug}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: clanek.nadpis.slice(0, 110),
  description: clanek.perex,
  datePublished: clanek.datumPublikace,
  mainEntityOfPage: adresa,
  ...(nahled ? { image: [new URL(nahled, Astro.site).href] } : {}),
  ...(obecNazev ? { contentLocation: { '@type': 'Place', name: obecNazev } } : {}),
  author: { '@type': 'Organization', name: `Rozhledna – ${region.nazev}`, url: new URL('/', Astro.site).href },
  publisher: { '@type': 'Organization', name: `Rozhledna – ${region.nazev}`, url: new URL('/', Astro.site).href },
};
---
<BaseLayout title={clanek.nadpis} description={clanek.perex} obrazek={nahled} typ="article" publikovano={clanek.datumPublikace} jsonLd={jsonLd}>
  <div class="container drobeckova">
    <a href="/">Domů</a>
    <span>/</span>
    <a href={`/rubrika/${rubrikaInfo?.slug}/`}>{rubrikaInfo?.nazev}</a>
    <span>/</span>
    <span class="drobeckova__aktualni">{obecNazev}</span>
  </div>

  <div class="container clanek-layout">
    <article class="clanek">
      <header class="clanek__header">
        <span class="kicker kicker--zelena">{rubrikaInfo?.nazev} · {obecNazev}</span>
        <h1 class="clanek__nadpis">{clanek.nadpis}</h1>
        <p class="clanek__perex">{clanek.perex}</p>
        <div class="clanek__byline">
          <div class="clanek__avatar">RR</div>
          <div>
            <div class="clanek__autor">{clanek.autor}</div>
            <div class="clanek__meta">{new Date(clanek.datumPublikace).toLocaleDateString('cs-CZ')} · {clanek.casCteniMin} min čtení</div>
          </div>
        </div>
      </header>

      {clanek.obrazek && (
        <figure class="clanek__foto">
          <Image
            src={clanek.obrazek.url}
            width={clanek.obrazek.sirka}
            height={clanek.obrazek.vyska}
            widths={[480, 800, 1100]}
            sizes="(max-width: 900px) 100vw, 720px"
            alt={clanek.obrazek.popis}
            loading="eager"
          />
          <figcaption class="clanek__obrazek-popisek">
            {clanek.obrazek.ilustracni && 'Ilustrační foto: '}{clanek.obrazek.popis}{clanek.obrazek.autor && <span class="clanek__obrazek-autor"> · {clanek.obrazek.autor}</span>}
          </figcaption>
        </figure>
      )}

      <div class="clanek__telo">
        {clanek.telo.map((odstavec: string) => blokTextu(odstavec)).map((blok) =>
          blok.typ === 'tabulka' ? (
            <div class="clanek__blok">
              {blok.mapa && <MapaHodnoty radky={blok.radky} popis={blok.hlavicka.join(' – ')} />}
              <details class="clanek__tabulka" open={!blok.mapa}>
                <summary>{blok.mapa ? 'Tabulka s hodnotami' : blok.hlavicka.join(' – ')}</summary>
                <div class="clanek__tabulka-obal">
                  <table>
                    <thead><tr>{blok.hlavicka.map((h) => <th>{h}</th>)}</tr></thead>
                    <tbody>{blok.radky.map((r) => <tr>{r.map((b) => <td>{b}</td>)}</tr>)}</tbody>
                  </table>
                </div>
              </details>
            </div>
          ) : (
            <p>
              {castiTextu(blok.text).map((c) =>
                c.href ? <a href={c.href} {...(c.externi ? { rel: 'noopener', target: '_blank' } : {})}>{c.text}</a> : c.text,
              )}
            </p>
          ),
        )}
      </div>

      {clanek.ukazkovyObsah && (
        <div class="clanek__upozorneni">
          Text je ukázkový obsah pro demonstraci rozvržení stránky, nejde o skutečnou zprávu.
        </div>
      )}

      {clanek.stitky?.length > 0 && (
        <div class="clanek__stitky">
          {clanek.stitky.map((s: string) => <span>#{s.replace(/\s+/g, '')}</span>)}
        </div>
      )}

      <FacebookOdkaz />
    </article>

    <aside class="postranni">
      {souvisejici.length > 0 && (
        <div class="postranni__blok postranni__blok--souvisejici">
          <h2>Související články</h2>
          {souvisejici.map((c) => <StoryCard clanek={c!} />)}
        </div>
      )}

      <div class="postranni__blok postranni__blok--newsletter">
        <h2>Přehled týdne do e-mailu</h2>
        <span>Jednou týdně, zdarma. Odhlásíte se kdykoliv jedním kliknutím.</span>
        <form data-newsletter>
          <label class="sr-only" for="sidebar-email">E-mail</label>
          <input id="sidebar-email" type="email" name="email" placeholder="vas@email.cz" autocomplete="email" required />
          <input type="text" name="web" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <button type="submit">Přihlásit se k odběru</button>
        </form>
        <p class="postranni__zprava" data-newsletter-zprava hidden></p>
      </div>
    </aside>
  </div>

  <div class="container">
    <NewsletterCTA />
  </div>
</BaseLayout>

<style>
  .drobeckova {
    display: flex;
    gap: 10px;
    padding-top: 20px;
    font-size: 13px;
    color: var(--barva-text-tlumena);
  }
  .drobeckova a { color: var(--barva-text-tlumena); }
  .drobeckova__aktualni { color: var(--barva-zelena); }

  .clanek-layout {
    display: flex;
    gap: 64px;
    padding-top: 24px;
    align-items: flex-start;
  }
  .clanek {
    flex: 2.2;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .clanek__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--barva-ramecek);
  }
  .clanek__nadpis {
    font-size: 38px;
    line-height: 1.22;
    font-weight: 700;
    max-width: 760px;
  }
  .clanek__perex {
    font-size: 18px;
    line-height: 1.55;
    color: var(--barva-text-tlumena-tmavsi);
    margin: 0;
    max-width: 760px;
  }
  .clanek__byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 4px;
  }
  .clanek__avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--barva-obrazek-placeholder);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--barva-text-tlumena);
  }
  .clanek__autor { font-size: 14px; font-weight: 600; }
  .clanek__meta { font-size: 13px; color: var(--barva-text-tlumena); }

  .clanek__foto { margin: 0; display: flex; flex-direction: column; gap: 22px; }
  .clanek__foto img { width: 100%; height: auto; display: block; }
  .clanek__obrazek-popisek { font-size: 13px; color: var(--barva-text-tlumena); margin-top: -12px; }

  .clanek__telo {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 17px;
    line-height: 1.6;
    max-width: 760px;
  }
  .clanek__telo p { margin: 0; }
  .clanek__telo a { color: var(--barva-terakota); text-decoration: underline; font-weight: 600; }
  .clanek__blok { display: flex; flex-direction: column; gap: 12px; }
  .clanek__tabulka summary { cursor: pointer; font-weight: 600; font-size: 15px; }
  .clanek__tabulka:not([open]) summary { color: var(--barva-terakota); }
  .clanek__tabulka[open] summary { list-style: none; margin-bottom: 8px; }
  .clanek__tabulka-obal { overflow-x: auto; }
  .clanek__tabulka table { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.4; }
  .clanek__tabulka th { text-align: left; font-weight: 700; border-bottom: 2px solid var(--barva-ramecek); padding: 6px 10px; }
  .clanek__tabulka td { border-bottom: 1px solid var(--barva-ramecek); padding: 6px 10px; }
  .clanek__tabulka td:not(:first-child), .clanek__tabulka th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }

  .clanek__upozorneni {
    padding: 20px 24px;
    background: var(--barva-obrazek-placeholder);
    border-left: 3px solid var(--barva-zelena);
    font-size: 14px;
    line-height: 1.6;
    color: var(--barva-text-tlumena-tmavsi);
  }

  .clanek__stitky {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .clanek__stitky span {
    font-size: 13px;
    padding: 6px 14px;
    border: 1px solid var(--barva-ramecek);
    color: var(--barva-text-tlumena-tmavsi);
  }

  .postranni {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: 24px;
  }
  .postranni__blok {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px;
  }
  .postranni__blok--souvisejici {
    background: var(--barva-obrazek-placeholder);
  }
  .postranni__blok h2 { font-size: 16px; font-weight: 600; }
  .postranni__blok--newsletter {
    background: var(--barva-zelena);
    gap: 12px;
  }
  .postranni__blok--newsletter h2 { color: var(--barva-pozadi); font-size: 17px; }
  .postranni__blok--newsletter span { color: #C9D3CB; font-size: 13px; line-height: 1.5; }
  .postranni__blok--newsletter form { display: flex; flex-direction: column; gap: 10px; }
  .postranni__zprava { margin: 0; color: var(--barva-pozadi); font-size: 14px; font-weight: 600; }
  .postranni__zprava.newsletter-zprava--chyba { color: #F3C9B4; }
  .postranni__blok--newsletter input {
    padding: 11px 14px; border: none; font-size: 14px; font-family: var(--font-tělo); width: 100%;
  }
  .postranni__blok--newsletter button {
    background: var(--barva-terakota); color: var(--barva-pozadi); border: none;
    padding: 12px; font-size: 14px; font-weight: 600; cursor: pointer;
  }

  @media (max-width: 900px) {
    .clanek-layout { flex-direction: column; gap: 32px; padding-top: 16px; }
    .clanek__nadpis { font-size: 26px; }
    .clanek__perex { font-size: 15px; }
    .clanek__foto { gap: 18px; }
    .clanek__telo { font-size: 16px; }
    .postranni { position: static; width: 100%; }
  }
</style>
