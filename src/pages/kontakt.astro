---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Kontakt" description="Kontakt na redakci Rozhledny.">
  <div class="container stranka">
    <h1>Kontakt</h1>
    <p>Redakce: redakce@rozhledna-chrudimsko.cz</p>
    <p>Inzerce: inzerce@rozhledna-chrudimsko.cz</p>
    <p>Máte fotku z obce? <a href="/poslete-fotku/">Pošlete nám ji přes formulář</a>.</p>
  </div>
</BaseLayout>

<style>
  .stranka {
    max-width: 760px;
    padding-top: 48px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .stranka h1 { font-size: 34px; }
  .stranka p { font-size: 16px; line-height: 1.65; color: var(--barva-text-tlumena-tmavsi); margin: 0; }

  @media (max-width: 900px) {
    .stranka { padding-top: 24px; padding-bottom: 40px; }
    .stranka h1 { font-size: 26px; }
  }
</style>
