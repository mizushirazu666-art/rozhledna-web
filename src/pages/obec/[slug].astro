---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import SportPrehled from '../../components/SportPrehled.astro';
import HlaseniIzs from '../../components/HlaseniIzs.astro';
import MapaObci from '../../components/MapaObci.astro';
import taxonomie from '../../data/taxonomie.json';
import { getClanky } from '../../lib/clanky';

export function getStaticPaths() {
  return taxonomie.obce.map((o) => ({ params: { slug: o.slug }, props: { obec: o } }));
}

const { obec } = Astro.props as { obec: (typeof taxonomie.obce)[number] };
const articlesData = await getClanky();
const clanky = articlesData.filter((c) => c.stav === 'Publikováno' && c.obec === obec.slug);
---
<BaseLayout title={obec.nazev} description={`Zprávy z obce ${obec.nazev} – Rozhledna, Chrudimsko.`}>
  <div class="container obec-hlavicka">
    <div class="obec-hlavicka__text">
      <span class="kicker kicker--zelena">Obec</span>
      <h1>{obec.nazev}</h1>
      <span class="obec-hlavicka__meta">{obec.obyvatel.toLocaleString('cs-CZ')} obyvatel</span>
    </div>
    <aside class="obec-mapa">
      <span class="obec-mapa__nadpis">Kde leží {obec.nazev}</span>
      <MapaObci vybrana={obec.slug} popisky={false} />
      <a class="obec-mapa__vse" href="/obce/">Všechny obce →</a>
    </aside>
  </div>

  <section class="container novinky">
    {clanky.length > 0 ? (
      <div class="novinky__mrizka">
        {clanky.map((c) => <StoryCard clanek={c} />)}
      </div>
    ) : (
      <p class="prazdno">Z této obce zatím nejsou žádné publikované zprávy.</p>
    )}
  </section>

  <div class="container">
    <SportPrehled obec={obec.slug} nadpis={`Sport – ${obec.nazev}`} />
  </div>

  <div class="container izs-obec">
    <HlaseniIzs obec={obec.slug} nadpis={`Bezpečnost – ${obec.nazev}`} />
  </div>

  <div class="container">
    <NewsletterCTA />
  </div>
</BaseLayout>

<style>
  .obec-hlavicka {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    padding-top: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--barva-ramecek);
  }
  .obec-hlavicka__text { display: flex; flex-direction: column; gap: 8px; }
  .obec-hlavicka h1 { font-size: 34px; }
  .obec-mapa {
    width: 300px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #F1E7D8;
    border-top: 3px solid var(--barva-zelena);
    padding: 14px 18px 16px;
  }
  .obec-mapa__nadpis { font-family: var(--font-nadpisy); font-size: 16px; font-weight: 700; }
  .obec-mapa__vse { font-size: 13px; font-weight: 600; }
  .obec-hlavicka__meta { font-size: 14px; color: var(--barva-text-tlumena); }
  .novinky { padding-top: 40px; padding-bottom: 48px; }
  .novinky__mrizka {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
  }
  .prazdno { color: var(--barva-text-tlumena); }

  @media (max-width: 900px) {
    .obec-hlavicka { padding-top: 24px; padding-bottom: 20px; flex-direction: column; gap: 20px; }
    .obec-mapa { width: 100%; box-sizing: border-box; }
    .obec-hlavicka h1 { font-size: 24px; }
    .novinky { padding-top: 22px; }
    .novinky__mrizka { grid-template-columns: 1fr; gap: 20px; }
  }
  .izs-obec { padding-bottom: 32px; }
</style>
