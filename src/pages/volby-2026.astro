---
// Živé výsledky komunálních voleb 2026 (10. 10. 2026). Data čte prohlížeč
// každou minutu z /api/volby (Vercel funkce, stahuje volby.gov.cz) – stránka
// se kvůli novým číslům nemusí přestavovat.
import region from '../data/region.json';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Volby 2026 živě – výsledky v obcích"
  description={`Průběžné výsledky komunálních voleb 2026 ve všech obcích ${region.genitiv}: účast, hlasy stran a zvolení zastupitelé.`}
>
  <div class="container volby">
    <p class="kicker kicker--terakota">Komunální volby 2026 · živě</p>
    <h1>Výsledky voleb v obcích {region.genitiv}</h1>
    <p class="volby__uvod">
      Průběžné výsledky načítáme přímo z Českého statistického úřadu (volby.gov.cz) a stránka se
      sama obnovuje každou minutu. Sčítat se začne v sobotu 10. října po 14. hodině, první obce
      bývají sečtené během odpoledne.
    </p>

    <div class="volby__stav" id="volby-stav" aria-live="polite">Načítám výsledky…</div>

    <label class="volby__hledat">
      <span>Najít obec</span>
      <input type="search" id="volby-hledat" placeholder="např. Slatiňany" autocomplete="off" />
    </label>

    <div class="volby__obce" id="volby-obce"></div>

    <p class="volby__zdroj">
      Zdroj: Český statistický úřad, <a href="https://volby.gov.cz/" rel="noopener">volby.gov.cz</a>.
      Do vyhlášení konečných výsledků jde o průběžný stav sčítání. Počet mandátů a jména zvolených
      zastupitelů ukážeme u obce, jakmile jsou výsledky konečné.
    </p>
  </div>
</BaseLayout>

<script>
  type Strana = { cislo: number; nazev: string; plnyNazev: string; hlasy: number; procent: number; mandaty: number | null; zvoleni: { jmeno: string; hlasy: number | null }[] };
  type Obec = {
    slug: string; nazev: string; dostupne: boolean; konecne: boolean; mandatu: number | null;
    okrskyCelkem: number | null; okrskyZpracovano: number | null; zpracovanoProcent: number | null;
    ucastProcent: number | null; strany: Strana[];
  };

  const stav = document.getElementById('volby-stav')!;
  const seznam = document.getElementById('volby-obce')!;
  const hledat = document.getElementById('volby-hledat') as HTMLInputElement;
  const otevrene = new Set<string>();
  let data: Obec[] = [];

  const cz = (n: number, des = 0) => n.toLocaleString('cs-CZ', { minimumFractionDigits: des, maximumFractionDigits: des });
  const el = (tag: string, trida?: string, text?: string) => {
    const e = document.createElement(tag);
    if (trida) e.className = trida;
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const sectenoHlasu = (o: Obec) => o.strany.some((s) => s.hlasy > 0);
  const bezDiakritiky = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  function stitek(o: Obec) {
    if (o.konecne) return el('span', 'stitek stitek--konec', 'Konečné výsledky');
    if (sectenoHlasu(o)) {
      const p = o.zpracovanoProcent;
      return el('span', 'stitek stitek--prubeh', p !== null && p > 0 && p <= 100 ? `Sčítá se · ${cz(p)} % okrsků` : 'Sčítá se');
    }
    return el('span', 'stitek', o.dostupne ? 'Zatím bez výsledků' : 'Data nedostupná');
  }

  function karta(o: Obec) {
    const k = el('article', 'karta');
    const hlava = el('div', 'karta__hlava');
    const odkaz = el('a', 'karta__nazev', o.nazev) as HTMLAnchorElement;
    odkaz.href = `/obec/${o.slug}/`;
    hlava.append(odkaz, stitek(o));
    k.append(hlava);

    const info: string[] = [];
    if (o.ucastProcent !== null && o.ucastProcent > 0 && o.ucastProcent <= 100) info.push(`Účast ${cz(o.ucastProcent, 2)} %`);
    if (o.mandatu) info.push(`${o.mandatu} míst v zastupitelstvu`);
    if (o.strany.length === 1) info.push('jediná kandidátka');
    if (info.length) k.append(el('p', 'karta__info', info.join(' · ')));

    const strany = el('div', 'karta__strany');
    // Nezávislí kandidáti jsou každý samostatná „strana“ – dlouhý seznam se
    // zkrátí na prvních 6, zbytek pod rozbalovací odkaz.
    const NAHORE = 6;
    const zbytek = el('details', 'karta__dalsi') as HTMLDetailsElement;
    zbytek.open = otevrene.has(`${o.slug}:dalsi`);
    zbytek.addEventListener('toggle', () => (zbytek.open ? otevrene.add(`${o.slug}:dalsi`) : otevrene.delete(`${o.slug}:dalsi`)));
    zbytek.append(el('summary', undefined, `Další kandidující (${Math.max(0, o.strany.length - NAHORE)})`));
    for (const [i, s] of o.strany.entries()) {
      const r = el('div', 'strana');
      const popis = el('div', 'strana__popis');
      popis.append(el('span', 'strana__nazev', s.plnyNazev || s.nazev));
      const cisla = sectenoHlasu(o) ? `${cz(s.procent, 2)} % · ${cz(s.hlasy)} hl.` : '';
      const mand = s.mandaty !== null ? ` · ${s.mandaty} ${s.mandaty === 1 ? 'mandát' : s.mandaty >= 2 && s.mandaty <= 4 ? 'mandáty' : 'mandátů'}` : '';
      popis.append(el('span', 'strana__cisla', cisla + mand));
      const pruh = el('div', 'strana__pruh');
      const vypln = el('div', 'strana__vypln');
      vypln.style.width = `${Math.max(0, Math.min(100, s.procent))}%`;
      pruh.append(vypln);
      r.append(popis, pruh);
      (i < NAHORE || o.strany.length <= NAHORE + 1 ? strany : zbytek).append(r);
    }
    if (o.strany.length > NAHORE + 1) strany.append(zbytek);
    k.append(strany);

    const zvoleni = o.strany.filter((s) => s.zvoleni.length);
    if (o.konecne && zvoleni.length) {
      const d = el('details', 'karta__zvoleni') as HTMLDetailsElement;
      d.open = otevrene.has(o.slug);
      d.addEventListener('toggle', () => (d.open ? otevrene.add(o.slug) : otevrene.delete(o.slug)));
      d.append(el('summary', undefined, 'Zvolení zastupitelé'));
      for (const s of zvoleni) {
        const p = el('p');
        p.append(el('strong', undefined, `${s.nazev}: `), document.createTextNode(s.zvoleni.map((z) => z.jmeno).join(', ')));
        d.append(p);
      }
      k.append(d);
    }
    return k;
  }

  function vykreslit() {
    const q = bezDiakritiky(hledat.value.trim());
    seznam.replaceChildren(...data.filter((o) => !q || bezDiakritiky(o.nazev).includes(q)).map(karta));
  }

  async function nacist() {
    try {
      const resp = await fetch('/api/volby', { cache: 'no-store' });
      const j = await resp.json();
      if (!j.ok) throw new Error();
      data = (j.obce as Obec[]).sort((a, b) => a.nazev.localeCompare(b.nazev, 'cs'));
      const konec = data.filter((o) => o.konecne).length;
      const prubeh = data.filter((o) => !o.konecne && sectenoHlasu(o)).length;
      const cas = new Date(j.stazeno).toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit' });
      stav.textContent = konec || prubeh
        ? `Konečné výsledky: ${konec} z ${data.length} obcí${prubeh ? `, sčítá se v dalších ${prubeh}` : ''}. Aktualizováno v ${cas}.`
        : `Výsledky zatím nejsou – sčítání začne v sobotu 10. 10. po 14:00. Kontrolováno v ${cas}.`;
      vykreslit();
    } catch {
      stav.textContent = 'Výsledky se teď nepodařilo načíst, zkusíme to znovu za minutu.';
    }
  }

  hledat.addEventListener('input', vykreslit);
  nacist();
  setInterval(nacist, 60_000);
</script>

<style>
  .volby { max-width: 900px; padding-top: 40px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 16px; }
  .volby h1 { font-size: 34px; line-height: 1.2; }
  .volby__uvod { font-size: 16px; line-height: 1.5; color: var(--barva-text-tlumena-tmavsi); margin: 0; }
  .volby__stav { background: var(--barva-zelena); color: #fff; padding: 12px 16px; border-radius: 6px; font-weight: 600; font-size: 15px; }
  .volby__hledat { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; }
  .volby__hledat input { font: inherit; font-weight: 400; padding: 10px 12px; border: 1px solid var(--barva-ramecek); border-radius: 6px; background: #fff; max-width: 360px; }
  .volby__obce { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .volby__zdroj { font-size: 13px; color: var(--barva-text-tlumena); line-height: 1.5; margin: 8px 0 0; }
  .volby__zdroj a { color: var(--barva-terakota); }

  .volby :global(.karta) { background: #fff; border: 1px solid var(--barva-ramecek); border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .volby :global(.karta__hlava) { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .volby :global(.karta__nazev) { font-size: 20px; font-weight: 700; color: var(--barva-text); }
  .volby :global(.karta__info) { margin: 0; font-size: 14px; color: var(--barva-text-tlumena-tmavsi); }
  .volby :global(.stitek) { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--barva-text-tlumena); }
  .volby :global(.stitek--prubeh) { color: var(--barva-terakota); }
  .volby :global(.stitek--konec) { color: var(--barva-zelena); }
  .volby :global(.karta__strany) { display: flex; flex-direction: column; gap: 8px; }
  .volby :global(.strana__popis) { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; line-height: 1.35; }
  .volby :global(.strana__cisla) { white-space: nowrap; color: var(--barva-text-tlumena-tmavsi); font-variant-numeric: tabular-nums; }
  .volby :global(.strana__pruh) { height: 6px; background: var(--barva-obrazek-placeholder); border-radius: 3px; overflow: hidden; margin-top: 3px; }
  .volby :global(.strana__vypln) { height: 100%; background: var(--barva-zelena); transition: width .4s; }
  .volby :global(.karta__dalsi summary) { cursor: pointer; font-size: 13px; color: var(--barva-text-tlumena-tmavsi); }
  .volby :global(.karta__dalsi[open]) { display: flex; flex-direction: column; gap: 8px; }
  .volby :global(.karta__zvoleni summary) { cursor: pointer; font-weight: 600; font-size: 14px; color: var(--barva-terakota); }
  .volby :global(.karta__zvoleni p) { font-size: 14px; line-height: 1.45; margin: 6px 0 0; }

  @media (max-width: 900px) {
    .volby { padding-top: 24px; gap: 12px; }
    .volby h1 { font-size: 26px; }
    .volby__obce { grid-template-columns: 1fr; }
  }
</style>
